<div class="card shadow-sm mb-4">
    <div class="card-body">
        <EditForm Model="model" OnValidSubmit="AddTodo">
            <DataAnnotationsValidator/>
            <ValidationSummary />
            <div class="input-group input-group-lg">
                <input @bind="model.Text"
                       type="text"
                       class="form-control"
                       placeholder="Add todo..."
                       autofocus>

                <button type="submit"
                        class="btn btn-primary">
                    Add
                </button>
            </div>

            <div class="mt-2">
                <ValidationMessage For="(() => model.Text)" />
            </div>

        </EditForm>

            <div class="form-text mt-2">
                Write something and click Add.
            </div>
    </div>
</div>


@code {
    private AddTodoItem model = new();

    [Parameter]
    public EventCallback<string> OnAdd { get; set; }

    private async Task AddTodo()
    {
        if (OnAdd.HasDelegate)
            await OnAdd.InvokeAsync(model.Text);

        model.Text = string.Empty;

    }
}
