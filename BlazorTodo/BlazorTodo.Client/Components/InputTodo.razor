<div class="card shadow-sm mb-4">
    <div class="card-body">
        <EditForm Model="model" OnValidSubmit="AddTodo" Context="_context">
            <DataAnnotationsValidator/>
            <div class="input-group input-group-lg">
                <InputText @bind-Value="model.Text"
                       class="form-control"
                       placeholder="Add todo..."
                       autofocus />

                <button type="submit"
                        class="btn btn-primary">
                    Add
                </button>
            </div>

            <div class="mt-2">
                <ValidationMessage For="(() => model.Text)" />
            </div>

            @if (_context.IsModified() && model.Text.Length > 2)
            {
                <div class="form-text text-warning">
                    You have unsaved changes.
                </div>
            }

        </EditForm>

            <div class="form-text mt-2">
                Write something and click Add.
            </div>
    </div>
</div>


@code {
    private AddTodoItem model = new();
    private EditContext _context = null!;

    protected override void OnInitialized()
    {
        _context = new EditContext(model);
    }

    [Parameter]
    public EventCallback<string> OnAdd { get; set; }

    private async Task AddTodo()
    {
        if (OnAdd.HasDelegate)
            await OnAdd.InvokeAsync(model.Text);

        model.Text = string.Empty;

    }
}
