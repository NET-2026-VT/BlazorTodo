<li class="list-group-item d-flex align-items-center justify-content-between py-3"
    data-id="@TodoItem.Id">
    <div class="d-flex align-items-center gap-3">
        <input class="form-check-input m-0" type="checkbox" checked="@TodoItem.Completed" @onchange="Complete">
        <div>
            <div class="fw-medium @(TodoItem.Completed ? "text-decoration-line-through" : "")">@TodoItem.Text</div>
            <div class="small text-secondary">Created: @TodoItem.Created</div>
        </div>
    </div>

    <button class="btn btn-outline-danger btn-sm" type="button" @onclick="Delete">
        Delete
    </button>
</li>

@code {

    [Parameter]
    public TodoItem TodoItem { get; set; } = null!;//new() { Text = "" };

    // [CascadingParameter(Name = "Delete")]
    // public EventCallback<Guid> OnDelete { get; set; }

    // [CascadingParameter(Name = "Complete")]
    // public EventCallback<Guid> OnComplete { get; set; }


    [CascadingParameter]
    public TodoActions Actions { get; set; } = null!;


        private async Task Delete()
    {
        if (Actions.OnDelete.HasDelegate)
            await Actions.OnDelete.InvokeAsync(TodoItem.Id);
    }

    private async Task Complete()
    {
        if (Actions.OnComplete.HasDelegate)
            await Actions.OnComplete.InvokeAsync(TodoItem.Id);
    }
}
