<ul class="list-group mt-4">
  
    @foreach(var item in TodoItems)
    {
        <Item @key="item.Id" TodoItem="item" OnDelete="OnDelete"/>
    }

</ul>

@code {

    [Parameter]
    public List<TodoItem> TodoItems { get; set; } = [];

    [Parameter]
    public EventCallback<Guid> OnDelete { get; set; }

}
