@page "/"

<PageTitle>ToDo</PageTitle>

<InputTodo OnAdd="AddTodo"/>

<CascadingValue Value="_actions"> 
         <Items TodoItems="_todoItems"/>
</CascadingValue>

@code {

    private List<TodoItem> _todoItems = null!;

    private TodoActions _actions = null!;

    protected override void OnInitialized()
    {
        _todoItems =
             [
                  new(){Text = "Buy bananas", Completed = true, Created = DateTime.Now.AddDays(-2)},
                  new(){Text = "Walk the dog"},
                  new(){Text = "Coffe",  Created = DateTime.Now.AddDays(-1).AddHours(5)},
     ];

        _actions = new TodoActions
            {
                OnDelete = EventCallback.Factory.Create<Guid>(this, DeleteTodo),
                OnComplete = EventCallback.Factory.Create<Guid>(this, CompleteTodo)
            };
    }

    private void AddTodo(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;

        _todoItems.Add(new TodoItem { Text = text.Trim() });
    }

    private void DeleteTodo(Guid id)
    {
        var item = _todoItems.FirstOrDefault(i => i.Id == id);

        if (item == null) return;

        _todoItems.Remove(item);

    }

    private void CompleteTodo(Guid id)
    {
        var item = _todoItems.FirstOrDefault(i => i.Id == id);

        if (item == null) return;

        item.Completed = !item.Completed;
    }

}
