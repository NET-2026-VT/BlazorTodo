@page "/"


<PageTitle>ToDo</PageTitle >

<InputTodo OnAdd="AddTodo" />

<CascadingValue Value="_actions"> 
         <Items TodoItems="_todoItems"/>
</CascadingValue>

@code {

    private IReadOnlyList<TodoItem> _todoItems = null!;

    private TodoActions _actions = null!;

    [Inject]
    public ITodoState State { get; set; } = null!;

    [Inject]
    public ITodoService TodoService { get; set; } = null!;

    protected override void OnInitialized()
    {
        _todoItems = TodoService.GetAll();

        UpdateCount();

        _actions = new TodoActions
            {
                OnDelete = EventCallback.Factory.Create<Guid>(this, DeleteTodo),
                OnComplete = EventCallback.Factory.Create<Guid>(this, CompleteTodo)
            };
    }

    private void AddTodo(string text)
    {
        TodoService.Add(text);

        UpdateCount();
    }

    private void DeleteTodo(Guid id)
    {
        TodoService.Delete(id);

        UpdateCount();

    }

    private void CompleteTodo(Guid id)
    {
        TodoService.ToggleComplete(id);
    }

    private void UpdateCount() => State.SetCount(_todoItems.Count);

}
